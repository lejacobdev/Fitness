<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Xcode's default template always carries these four keys as build-setting
	  placeholders. Omitting CFBundleIdentifier in particular produces an app
	  with no bundle ID: it builds cleanly but the simulator (and, identically,
	  a real device) refuses to install it — "Missing bundle ID" — which is
	  otherwise indistinguishable from a signing problem until you look closely.
	-->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<key>CFBundleDisplayName</key>
	<string>Athlete OS</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- §15: portrait only, on iPhone. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!--
	  The device family is "1,2" (iPhone + iPad), and Apple's upload validator
	  requires an iPad-eligible app to support all four orientations for
	  multitasking (Split View / Slide Over) — confirmed by a real rejected
	  upload: "Invalid bundle... you need to include all of the
	  UIInterfaceOrientationPortrait, UIInterfaceOrientationPortraitUpsideDown,
	  UIInterfaceOrientationLandscapeLeft, UIInterfaceOrientationLandscapeRight
	  orientations to support iPad multitasking." The ~ipad-suffixed key
	  overrides the base key on iPad only, so the phone stays portrait-only
	  exactly as §15 specifies while iPad satisfies Apple's own requirement.
	-->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!--
	  §17: both strings are mandatory. An app with the HealthKit entitlement and
	  only one of these is rejected at upload.
	-->
	<key>NSHealthShareUsageDescription</key>
	<string>Athlete OS reads your sleep, workouts and heart rate so your morning check-in and training load reflect what your body actually did. You can use the whole app without granting this.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Athlete OS saves the sessions you log to Health so they appear alongside your other activity. You can use the whole app without granting this.</string>

	<!--
	  §17: healthkit must NOT appear in UIRequiredDeviceCapabilities. Declaring it
	  makes the app undownloadable on devices App Review may use, and the app is
	  required to work fully with every permission denied anyway.
	-->

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
