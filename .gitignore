# Xcode project is generated by XcodeGen — never committed (§19)
*.xcodeproj/
*.xcworkspace/
!*.xcodeproj/project.xcworkspace/
xcuserdata/
DerivedData/
build/
*.ipa
*.xcarchive
ExportOptions.plist

# Signing material must never enter the repo
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.keychain-db

# Node
node_modules/
npm-debug.log*
.env
.env.*
!.env.example

# Prisma
backend/prisma/*.db
backend/prisma/migrations/dev.db*

# Generated content packs and codegen output
content/dist/
app/Shared/Sources/Generated/

# OS
.DS_Store
Thumbs.db
