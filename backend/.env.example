# Copy to .env and fill in. .env is gitignored and must never be committed.

# Postgres. Use a long random value; this database holds minors' wellness data.
POSTGRES_USER=athlete
POSTGRES_PASSWORD=
POSTGRES_DB=student_athlete

# Port the API is published on locally.
API_PORT=8080

# Signs our own session tokens (not Apple's). Rotate by replacing this value;
# every client then signs in again, which is the intended effect.
#   openssl rand -base64 48
SESSION_SECRET=

# The `aud` every Apple identity token must carry (§3). Must equal the app's
# bundle identifier exactly.
APPLE_BUNDLE_ID=com.studentathlete.app

# Shown by /health so a deployed build can be identified.
APP_VERSION=dev

# Push notifications: an APNs auth key (Apple Developer > Keys > Apple Push
# Notifications service). Put the .p8 in backend/secrets/ and give its path as
# seen inside the container. Leave empty to send no pushes.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=/run/secrets/siwa/AuthKey_XXXXXXXXXX.p8
